generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  nameKey      String   @unique
  role         String   @default("member")
  passwordHash String?
  passwordSalt String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lastSeenAt DateTime  @default(now())
  deletedAt  DateTime?

  checkIns     CheckIn[]
  contentReads ContentRead[]
}

model Content {
  id String @id @default(cuid())

  title       String
  contentType String @default("recording")
  status      String @default("draft")

  // 旧字段：暂时保留，保护已有数据
  speaker String?
  series  String?

  // 新关系字段
  speakerId String?
  seriesId  String?

  speakerRef Speaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)
  seriesRef  Series?  @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  description String
  scripture   String?
  contentBody String?

  resourceUrl        String?
  date               String
  duration           String?
  tagsText           String  @default("")
  searchKeywordsText String  @default("")
  coverColor         String  @default("#7c6f64")

  viewCount Int @default(0)

  publishedAt DateTime?
  archivedAt  DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads     ContentRead[]
  favorites ContentFavorite[]
  checkIns  CheckIn[]

  @@index([speakerId])
  @@index([seriesId])
  @@index([createdAt, id])
}

model Speaker {
  id      String @id @default(cuid())
  name    String
  nameKey String @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contents Content[]
}

model Series {
  id          String  @id @default(cuid())
  title       String
  titleKey    String  @unique
  description String?
  imageUrl    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contents Content[]
}

model ContentRead {
  id String @id @default(cuid())

  contentId String
  userId    String

  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentId, userId])
}

model ContentFavorite {
  id String @id @default(cuid())

  contentId  String
  visitorKey String

  createdAt DateTime @default(now())

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, visitorKey])
  @@index([visitorKey])
}

model CheckIn {
  id              String   @id @default(cuid())
  userId          String
  sermonId        String?
  listenedAt      DateTime @default(now())
  progressPercent Int      @default(100)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content Content? @relation(fields: [sermonId], references: [id], onDelete: Cascade)

  @@unique([userId, sermonId])
  @@index([sermonId])
}

// Blobs of hard-deleted Content, deleted by the retention job after the Content
// transaction commits (see docs/content-retention.md). Rows are removed once handled.
model BlobDeletionOutbox {
  id           String    @id @default(cuid())
  url          String    @unique
  pathname     String
  contentId    String // the deleted Content row (no FK: it no longer exists)
  attempts     Int       @default(0)
  lastError    String? // sanitized, never contains the URL
  claimedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([claimedUntil, createdAt])
}

// Admin login throttling (src/lib/loginThrottle.ts). "key" is an HMAC of the
// client address; raw addresses are never stored. Stale rows are pruned on login.
model LoginThrottle {
  key          String    @id
  attempts     Int       @default(0)
  windowStart  DateTime
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
}

model Share {
  id String @id @default(cuid())

  name    String
  title   String
  content String

  ownerKey String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime
  deletedAt DateTime?

  favorites ShareFavorite[]

  @@index([ownerKey])
  @@index([expiresAt])
  @@index([expiresAt, id])
}

model ShareFavorite {
  id String @id @default(cuid())

  shareId    String
  visitorKey String

  createdAt DateTime @default(now())

  share Share @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@unique([shareId, visitorKey])
  @@index([visitorKey])
}
