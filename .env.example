# Copy to .env for local development. Never commit real values.
# Use a local or disposable PostgreSQL database here, not Production.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/faith_learning_dev"

# Admin password (also signs admin sessions). Use a long random value.
ADMIN_PASSWORD="change-this"

# Optional locally; required in Production.
# CRON_SECRET="long-random-value"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# SHARE_RETENTION_DELETE_ENABLED="false"
